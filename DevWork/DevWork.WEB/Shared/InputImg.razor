<div>
    <label class="form-label">@Label</label>
    <div>
        <InputFile OnChange="OnChange" accept=".jpg,.jpeg,.png" class="form-control" />
    </div>
</div>

<div>
    @if (imageBase64 is not null)
    {
        <div>
            <div style="margin: 10px">
                <img src="data:image/jpeg;base64,@imageBase64" style="width: 250px; border-radius: 8px;" />
            </div>
        </div>
    }
    @if (ImageURL is not null)
    {
        <div>
            <div style="margin: 10px">
                <img src="@ImageURL" style="width: 250px; border-radius: 8px;" />
            </div>
        </div>
    }
</div>

@code {
    private string? imageBase64;

    [Parameter] public string Label { get; set; } = "Imagen";
    [Parameter] public string? ImageURL { get; set; }
    [Parameter] public EventCallback<string> ImageSelected { get; set; }

    private async Task OnChange(InputFileChangeEventArgs e)
    {
        var imagenes = e.GetMultipleFiles();

        foreach (var imagen in imagenes)
        {
            // Redimensiona la imagen en el navegador a máximo 500x500px (reduce el peso a ~50-100 KB)
            var imagenRedimensionada = await imagen.RequestImageFileAsync("image/jpeg", 500, 500);

            using var stream = imagenRedimensionada.OpenReadStream(maxAllowedSize: 5120000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var arrBytes = ms.ToArray();
            imageBase64 = Convert.ToBase64String(arrBytes);
            ImageURL = null;
            await ImageSelected.InvokeAsync(imageBase64);
            StateHasChanged();
        }
    }
}