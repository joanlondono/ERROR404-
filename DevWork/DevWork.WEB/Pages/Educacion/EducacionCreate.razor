@page "/educacion/create"
@using DevWork.Shared.Models
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<h3>Crear educación</h3>

<EducacionForm @ref="educacionForm" Educacion="educacion" OnSubmit="Create" ReturnAction="Return" />

@code {
    private Educacion educacion = new();
    private EducacionForm educacionForm = null!;

    private async Task Create()
    {
        var responseHttp = await repository.PostAsync("api/educaciones", educacion);
        if (responseHttp.Error)
        {
            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        educacionForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("educacion");
    }

    private void Return() => navigationManager.NavigateTo("educacion");
}
