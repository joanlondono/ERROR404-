@page "/educacion"
@inject NavigationManager navigationManager
@inject SweetAlertService swal
@inject IRepository repository

 <h3>Educacionindex</h3>
<div class="mb-3">

 

 

    <a class="btn btn-primary " href="/educacion/Create">New Educacion</a>

 

</div>

 

<GenericList MyList="educacion">


    <Body>

        <table class="table table-striped">

            <thead>

                <tr>

                    <th>Id</th>

                    <th>PerfilProfesionalId</th>
                    <th>Titulo</th>
                    <th>Institucion</th>
                    <th>FechaInicio</th>
                    <th>FechaFin</th>

                   

                </tr>

            </thead>

            <tbody>

                @foreach (var Educacion in educacion!)

                {

                    <tr>

                         

                        <td>

                            @Educacion.Id

                        </td>

                        <td>

                            @Educacion.PerfilProfesionalId

                        </td>
                        <td>

                            @Educacion.Titulo

                        </td>

                        <td>

                            @Educacion.Institucion

                        </td>
                        <td>

                            @Educacion.FechaInicio

                        </td>
                        <td>

                            @Educacion.FechaFin

                        </td>
                        <td>

                            <a href="/educacion/edit/@Educacion.Id" class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger" @onclick=@(() => DeleteAsync(Educacion))>Borrar</button>

                        </td>

 

                    </tr>

                }

            </tbody>

        </table>

 

    </Body>

  

</GenericList>

 

 

 

 

 

@code {

    public List<Educacion> educacion { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var responseHppt = await repository.GetAsync<List<Educacion>>("/api/Educaciones");
        educacion = responseHppt.Response!;
    }

    private async Task DeleteAsync(Educacion Educacion)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Esta seguro que quieres borrar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        var confirm = string.IsNullOrEmpty(result.Value);

        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.DeleteAsync($"api/Educaciones/{Educacion.Id}");

        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/educacion");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await Load();
        }
    }

}

 











