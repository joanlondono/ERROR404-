@page "/educacion"
@using DevWork.Shared.Models
@inject NavigationManager navigationManager
@inject SweetAlertService swal
@inject IRepository repository

<h3>Educacion</h3>

<div class="mb-3">
    <a class="btn btn-primary" href="educacion/create">New Educacion</a>
</div>

<GenericList MyList="educaciones">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>PerfilProfesionalId</th>
                    <th>Titulo</th>
                    <th>Institucion</th>
                    <th>FechaInicio</th>
                    <th>FechaFin</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in educaciones!)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.PerfilProfesionalId</td>
                        <td>@item.Titulo</td>
                        <td>@item.Institucion</td>
                        <td>@item.FechaInicio</td>
                        <td>@item.FechaFin</td>
                        <td>
                            <a href="educacion/edit/@item.Id" class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger" @onclick="@(() => DeleteAsync(item))">Borrar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>

@code {
    public List<Educacion>? educaciones { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var responseHttp = await repository.GetAsync<List<Educacion>>("api/educaciones");
        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await swal.FireAsync("Error", $"No se pudo cargar la educación: {mensajeError}", SweetAlertIcon.Error);
            educaciones = new List<Educacion>();
            return;
        }

        educaciones = responseHttp.Response!;
    }

    private async Task DeleteAsync(Educacion item)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Está seguro que quieres borrar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.DeleteAsync($"api/educaciones/{item.Id}");
        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("educacion");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await Load();
        }
    }
}