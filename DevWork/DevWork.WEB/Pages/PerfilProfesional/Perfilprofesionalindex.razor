@page "/Perfiles" 

@inject NavigationManager navigationManager
@inject SweetAlertService swal

@inject IRepository repository

<h3>Perfilprofesionalindex</h3>
<div class="mb-3">

 

 

    <a class="btn btn-primary " href="/PerfilesProfesionales/Create">New PerfilProfesional</a>

 

</div>

 

<GenericList MyList="PerfilesProfesionales">


    <Body>

        <table class="table table-striped">

            <thead>

                <tr>

                    <th>Id</th>

                    <th>UserId</th>
                    <th>NombreCompleto</th>
                    <th>TituloProfesional</th>
                    <th>Biografia</th>
                    <th>HabilidadesTecnicas</th>
                    <th>AreaEspecialidad</th>
                    <th>TarifaHora</th>
                    <th>EnlaceGithub</th>
                    <th>EnlaceLinkedin</th>
                   

                   

                </tr>

            </thead>

            <tbody>

                @foreach (var PF in PerfilesProfesionales!)

                {
                    <tr>

                    
                         <td>

                            @PF.Id

                        </td>

                        <td>

                            @PF.UserId

                        </td>
                        <td>
                            @PF.NombreCompleto
                            

                        </td> 
                        <td>
                            @PF.TituloProfesional
                            </td>
                        <td>
                            @PF.Biografia
                            </td>
                        <td>
                            @PF.HabilidadesTecnicas
                            </td>       
                        <td>
                            @PF.AreaEspecialidad
                            </td>
                        <td>
                            @PF.TarifaHora
                         </td>
                         <td>
                            @PF.EnlaceGitHub
                        </td>
                        <td>
                            @PF.EnlaceLinkedIn
                        </td>
                         

                      


                        
                      <td>

                            <a href="/PerfilesProfesionales/edit/@PF.Id" class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger" @onclick=@(() => DeleteAsync(PF))>Borrar</button>

                        </td>

 

                    </tr>

                }

            </tbody>

        </table>

 

    </Body>

  

</GenericList>

 

 

 

 

 

@code {

    public List<PerfilProfesional> PerfilesProfesionales { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var responseHppt = await repository.GetAsync<List<PerfilProfesional>>("/api/PerfilesProfesionales");
        PerfilesProfesionales = responseHppt.Response!;
    }

    private async Task DeleteAsync(PerfilProfesional PerfilProfesional)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Esta seguro que quieres borrar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        var confirm = string.IsNullOrEmpty(result.Value);

        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.DeleteAsync($"api/PerfilesProfesionales/{PerfilProfesional.Id}");

        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/perfiles-profesionales");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await Load();
        }
    }
}

 













