    private async Task BuscarPerfilesAsync()
    {
        var url = string.IsNullOrWhiteSpace(filtroTexto)
            ? "api/perfilesprofesionales"
            : $"api/perfilesprofesionales/filter?text={Uri.EscapeDataString(filtroTexto)}";

        var resp = await repository.GetAsync<List<PerfilProfesional>>(url);
        if (!resp.Error && resp.Response != null)
        {
            todosLosPerfiles = resp.Response;
        }
    }

    private async Task LimpiarFiltroAsync()
    {
        filtroTexto = string.Empty;
        await BuscarPerfilesAsync();
    }

    private async Task DeleteAsync(PerfilProfesional perfilProfesional)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = $"¿Está seguro que quieres borrar el perfil de {perfilProfesional.NombreCompleto}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        if (string.IsNullOrEmpty(result.Value))
        {
            return;
        }

        var responseHTTP = await repository.DeleteAsync($"api/perfilesprofesionales/{perfilProfesional.Id}");

        if (responseHTTP.Error)
        {
            var mensajeError = await responseHTTP.GetErrorMessageAsync();
            await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
        }
        else
        {
            if (miPerfil?.Id == perfilProfesional.Id)
            {
                miPerfil = null;
                misExperiencias = new();
                misEducaciones = new();
                misCertificaciones = new();
            }
            await Load();
        }
    }
