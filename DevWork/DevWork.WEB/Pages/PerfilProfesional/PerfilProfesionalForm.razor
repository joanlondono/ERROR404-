@inject SweetAlertService swal

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<div class="p-4 rounded-4 shadow-sm" style="background-color: #111827; border: 1px solid rgba(255,255,255,0.08); max-width: 820px;">
    <EditForm EditContext="editContext" OnValidSubmit="OnSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger small mb-3" />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-semibold" style="color: #CBD5E1;">Id de Usuario</label>
                <InputNumber class="form-control"
                             style="background-color: #0F172A; border-color: rgba(255,255,255,0.12); color: #F8FAFC;"
                             @bind-Value="PerfilProfesional.UserId" />
                <ValidationMessage For="@(() => PerfilProfesional.UserId)" class="text-danger small mt-1" />
            </div>

            <div class="col-md-8">
                <label class="form-label small fw-semibold" style="color: #CBD5E1;">Nombre Completo</label>
                <InputText class="form-control"
                           placeholder="Ej. Juan David Mosquera"
                           style="background-color: #0F172A; border-color: rgba(255,255,255,0.12); color: #F8FAFC;"
                           @bind-Value="PerfilProfesional.NombreCompleto" />
                <ValidationMessage For="@(() => PerfilProfesional.NombreCompleto)" class="text-danger small mt-1" />
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-semibold" style="color: #CBD5E1;">Título Profesional</label>
                <InputText class="form-control"
                           placeholder="Ej. Desarrollador Full Stack .NET"
                           style="background-color: #0F172A; border-color: rgba(255,255,255,0.12); color: #F8FAFC;"
                           @bind-Value="PerfilProfesional.TituloProfesional" />
                <ValidationMessage For="@(() => PerfilProfesional.TituloProfesional)" class="text-danger small mt-1" />
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-semibold" style="color: #CBD5E1;">Área de Especialidad</label>
                <InputText class="form-control"
                           placeholder="Ej. Backend, Web APIs, Cloud"
                           style="background-color: #0F172A; border-color: rgba(255,255,255,0.12); color: #F8FAFC;"
                           @bind-Value="PerfilProfesional.AreaEspecialidad" />
                <ValidationMessage For="@(() => PerfilProfesional.AreaEspecialidad)" class="text-danger small mt-1" />
            </div>

            <div class="col-12">
                <label class="form-label small fw-semibold" style="color: #CBD5E1;">Biografía</label>
                <InputTextArea class="form-control"
                               rows="3"
                               placeholder="Resume tu experiencia, enfoque técnico y tipo de proyectos en los que te especializas..."
                               style="background-color: #0F172A; border-color: rgba(255,255,255,0.12); color: #F8FAFC;"
                               @bind-Value="PerfilProfesional.Biografia" />
                <ValidationMessage For="@(() => PerfilProfesional.Biografia)" class="text-danger small mt-1" />
            </div>

            <div class="col-12">
                <label class="form-label small fw-semibold" style="color: #CBD5E1;">Habilidades Técnicas</label>
                <InputTextArea class="form-control"
                               rows="2"
                               placeholder="Separadas por coma: C#, ASP.NET Core, Blazor, SQL Server, Git..."
                               style="background-color: #0F172A; border-color: rgba(255,255,255,0.12); color: #F8FAFC;"
                               @bind-Value="PerfilProfesional.HabilidadesTecnicas" />
                <small class="d-block mt-1" style="color: #94A3B8; font-size: 0.78rem;">
                    Separa cada tecnología con una coma para mostrarlas como etiquetas en tu perfil.
                </small>
                <ValidationMessage For="@(() => PerfilProfesional.HabilidadesTecnicas)" class="text-danger small mt-1" />
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-semibold" style="color: #CBD5E1;">Tarifa por Hora (USD)</label>
                <div class="input-group">
                    <span class="input-group-text"
                          style="background-color: #1E293B; border-color: rgba(255,255,255,0.12); color: #94A3B8;">$</span>
                    <InputNumber class="form-control"
                                 style="background-color: #0F172A; border-color: rgba(255,255,255,0.12); color: #F8FAFC;"
                                 @bind-Value="PerfilProfesional.TarifaHora" />
                </div>
                <ValidationMessage For="@(() => PerfilProfesional.TarifaHora)" class="text-danger small mt-1" />
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-semibold" style="color: #CBD5E1;">Enlace de GitHub</label>
                <InputText class="form-control"
                           placeholder="https://github.com/usuario"
                           style="background-color: #0F172A; border-color: rgba(255,255,255,0.12); color: #F8FAFC;"
                           @bind-Value="PerfilProfesional.EnlaceGitHub" />
                <ValidationMessage For="@(() => PerfilProfesional.EnlaceGitHub)" class="text-danger small mt-1" />
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-semibold" style="color: #CBD5E1;">Enlace de LinkedIn</label>
                <InputText class="form-control"
                           placeholder="https://linkedin.com/in/usuario"
                           style="background-color: #0F172A; border-color: rgba(255,255,255,0.12); color: #F8FAFC;"
                           @bind-Value="PerfilProfesional.EnlaceLinkedIn" />
                <ValidationMessage For="@(() => PerfilProfesional.EnlaceLinkedIn)" class="text-danger small mt-1" />
            </div>
        </div>

        <hr class="my-4" style="border-color: rgba(255,255,255,0.08);" />

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary px-4" type="submit">
                Guardar
            </button>
            <button class="btn btn-outline-light px-4" type="button" @onclick="ReturnAction">
                Regresar
            </button>
        </div>
    </EditForm>
</div>

@code {
    private EditContext editContext = null!;

    [EditorRequired]
    [Parameter]
    public PerfilProfesionalModel PerfilProfesional { get; set; } = null!;

    [EditorRequired]
    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [EditorRequired]
    [Parameter]
    public EventCallback ReturnAction { get; set; }

    public bool FormPostedSuccessfully { get; set; }

    protected override void OnInitialized()
    {
        editContext = new EditContext(PerfilProfesional);
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (!editContext.IsModified() || FormPostedSuccessfully)
        {
            return;
        }

        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Deseas abandonar la página y perder los cambios?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true
        });

        if (string.IsNullOrEmpty(result.Value))
        {
            context.PreventNavigation();
        }
    }
}