@page "/perfiles/create"

@using DevWork.Shared.Models
@using DevWork.WEB.Pages.PerfilProfesional
@* Nota: Si guardaste PerfilProfesionalForm en otra carpeta, ajusta la línea de arriba con su namespace *@

@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<h3>Crear perfil profesional</h3>

<PerfilProfesionalForm @ref="perfilForm" PerfilProfesional="perfil" OnSubmit="Create" ReturnAction="Return" />

@code {
    private PerfilProfesionalModel perfil = new();
    private PerfilProfesionalForm perfilForm = null!;

    private async Task Create()
    {
        // CORREGIDO: Se usa ruta relativa limpia y en plural "api/perfilesprofesionales"
        var responseHttp = await repository.PostAsync("api/perfilesprofesionales", perfil);
        
        if (responseHttp.Error)
        {
            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        perfilForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("Perfiles");
    }

    private void Return() => navigationManager.NavigateTo("Perfiles");
}
