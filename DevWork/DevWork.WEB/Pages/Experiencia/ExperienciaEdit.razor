@page "/experiencias/edit/{Id:int}"

@inject NavigationManager navigationManager
@inject IRepository repository
@inject SweetAlertService swal

<h3>Editar experiencia</h3>

@if (experiencia is null)
{
    <p>Cargando...</p>
}
else
{
    <ExperienciaForm @ref="experienciaForm"
                     Experiencia="experiencia"
                     OnSubmit="Edit"
                     ReturnAction="Return" />
}

@code {
    private ExperienciaProfesionalModel? experiencia;
    private ExperienciaForm experienciaForm = null!;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var response = await repository.GetAsync<ExperienciaProfesionalModel>(
            $"/api/experiencia/{Id}");

        if (response.Error)
        {
            if (response.HttpResponseMessage.StatusCode ==
                System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/ExperienciaProfesional");
                return;
            }

            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        experiencia = response.Response;
    }

    private async Task Edit()
    {
        var response = await repository.PutAsync("/api/experiencia", experiencia);

        if (response.Error)
        {
            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        experienciaForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("/ExperienciaProfesional");
    }

    private void Return()
    {
        navigationManager.NavigateTo("/ExperienciaProfesional");
    }
}
 