@page "/experiencias/edit/{Id:int}"
@attribute [Authorize]
@using DevWork.Shared.Models
@inject NavigationManager navigationManager
@inject IRepository repository
@inject SweetAlertService swal

<PageTitle>Editar Experiencia - DevWork</PageTitle>

<div class="mb-3">
    <a href="/ExperienciaProfesional" class="btn btn-sm btn-outline-light">
        ← Volver a Experiencia Profesional
    </a>
</div>

<div class="mx-auto" style="max-width: 820px;">
    <div class="p-4 p-md-5 rounded-4" style="background-color: #111827; border: 1px solid rgba(255,255,255,0.08);">
        <div class="mb-4 pb-3 border-bottom" style="border-color: rgba(255,255,255,0.08) !important;">
            <h3 class="fw-bold text-white mb-1">Editar Experiencia Profesional</h3>
            <small style="color: #94A3B8;">Actualiza el cargo, empresa, fechas y descripción de la trayectoria laboral</small>
        </div>

        @if (experiencia is null)
        {
            <div class="d-flex justify-content-center my-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            <ExperienciaForm @ref="experienciaForm"
                             Experiencia="experiencia"
                             OnSubmit="Edit"
                             ReturnAction="Return" />
        }
    </div>
</div>

@code {
    private ExperienciaProfesionalModel? experiencia;
    private ExperienciaForm experienciaForm = null!;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var response = await repository.GetAsync<ExperienciaProfesionalModel>($"api/experiencias/{Id}");

        if (response.Error)
        {
            if (response.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/ExperienciaProfesional");
                return;
            }

            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        experiencia = response.Response;
    }

    private async Task Edit()
    {
        var response = await repository.PutAsync("api/experiencias", experiencia);

        if (response.Error)
        {
            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        experienciaForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("/ExperienciaProfesional");
    }

    private void Return()
    {
        navigationManager.NavigateTo("/ExperienciaProfesional");
    }
}