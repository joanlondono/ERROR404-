@page "/ExperienciaProfesional"
@inject NavigationManager navigationManager
@inject SweetAlertService swal
@inject IRepository repository
<h3>Experiencia Profesional</h3>
<div class="mb-3">

 

 

    <a class="btn btn-primary " href="/ExperienciaProfesional/Create">New Experiencia</a>

 

</div>

 

<GenericList MyList="Experienciaprofesional">


    <Body>

        <table class="table table-striped">

            <thead>

                <tr>

                    <th>Id</th>

                    <th>PerfilProfesionalId</th>
                    <th>Cargo</th>
                    <th>Empresa</th>
                    <th>Descripcion</th>
                    <th>FechaInicio</th>
                    <th>FechaFin</th>
                   

                   

                </tr>

            </thead>

            <tbody>

                @foreach (var experiencia in Experienciaprofesional!)

                {

                    <tr>


                         

                        <td>

                            @experiencia.Id

                        </td>
                        <td>@experiencia.PerfilProfesionalId</td>
                        <td>@experiencia.Cargo</td>
                        <td>@experiencia.Empresa</td>
                        <td>@experiencia.Descripcion</td>
                        <td>@experiencia.FechaInicio</td>
                        <td>@experiencia.FechaFin</td>

                        
                        
                        <td>

                            <a href="/Experiencias/edit/@experiencia.Id" class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger" @onclick=@(() => DeleteAsync(experiencia))>Borrar</button>

                        </td>

 

                    </tr>

                }

            </tbody>

        </table>

 

    </Body>

  

</GenericList>

 

 

 

 

 

@code {
    // Cambia 'experiencias' por 'Experienciaprofesional' en estas 4 líneas:
    public List<Experiencia>? Experienciaprofesional { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var responseHttp = await repository.GetAsync<List<Experiencia>>("api/experiencias");
        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await swal.FireAsync("Error", $"No se pudo cargar la experiencia: {mensajeError}", SweetAlertIcon.Error);
            Experienciaprofesional = new List<Experiencia>();
            return;
        }

        Experienciaprofesional = responseHttp.Response!;
    }

    private async Task DeleteAsync(Experiencia item)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Está seguro que quieres borrar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.DeleteAsync($"api/experiencias/{item.Id}");
        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("ExperienciaProfesional");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await Load();
        }
    }
}
