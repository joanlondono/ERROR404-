@page "/ExperienciaProfesional"
@attribute [Authorize(Roles = "Admin,Administrador")]
@using DevWork.Shared.Models
@inject NavigationManager navigationManager
@inject SweetAlertService swal
@inject IRepository repository

<PageTitle>Experiencia Profesional - DevWork</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-white">Experiencia Profesional</h3>
        <small style="color: #94A3B8;">Trayectoria laboral y cargos desempeñados</small>
    </div>
    <a class="btn btn-primary shadow-sm px-4" href="/ExperienciaProfesional/Create">
        + Nueva Experiencia
    </a>
</div>

<GenericList MyList="Experienciaprofesional">
    <Body>
        <div class="d-flex flex-column gap-3">
            @foreach (var experiencia in Experienciaprofesional!.OrderByDescending(e => e.FechaInicio))
            {
                var inicioTexto = experiencia.FechaInicio.Year > 1
                    ? experiencia.FechaInicio.ToString("MMM yyyy")
                    : "Sin fecha de inicio";

                var esActual = !experiencia.FechaFin.HasValue || experiencia.FechaFin.Value.Year <= 1;
                var finTexto = esActual
                    ? "Actualidad"
                    : experiencia.FechaFin!.Value.ToString("MMM yyyy");

                <div class="profile-card p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <!-- Información principal del cargo -->
                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <span class="badge-area">@experiencia.Empresa</span>

                                <span class="small px-2 py-1 rounded-2"
                                      style="background-color: #0F172A; color: #CBD5E1; border: 1px solid rgba(255,255,255,0.08);">
                                    <i class="bi bi-calendar-range me-1"></i>
                                    @inicioTexto —
                                    @if (esActual)
                                    {
                                        <span class="fw-semibold" style="color: #34D399;">Actualidad</span>
                                    }
                                    else
                                    {
                                        <span>@finTexto</span>
                                    }
                                </span>
                            </div>

                            <h5 class="fw-bold text-white mb-2">@experiencia.Cargo</h5>

                            @if (!string.IsNullOrWhiteSpace(experiencia.Descripcion))
                            {
                                <p class="mb-0" style="color: #CBD5E1; font-size: 0.95rem; line-height: 1.6; white-space: pre-line;">
                                    @experiencia.Descripcion
                                </p>
                            }
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-flex gap-2">
                            <a href="/Experiencias/edit/@experiencia.Id" class="btn btn-sm btn-warning px-3">
                                Editar
                            </a>
                            <button class="btn btn-sm btn-danger px-3" @onclick=@(() => DeleteAsync(experiencia))>
                                Borrar
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Body>
</GenericList>

@code {
    public List<Experiencia>? Experienciaprofesional { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var responseHttp = await repository.GetAsync<List<Experiencia>>("api/experiencias");
        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await swal.FireAsync("Error", $"No se pudo cargar la experiencia: {mensajeError}", SweetAlertIcon.Error);
            Experienciaprofesional = new List<Experiencia>();
            return;
        }

        Experienciaprofesional = responseHttp.Response!;
    }

    private async Task DeleteAsync(Experiencia item)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Está seguro que quieres borrar este registro de experiencia?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.DeleteAsync($"api/experiencias/{item.Id}");
        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("ExperienciaProfesional");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await Load();
        }
    }
}