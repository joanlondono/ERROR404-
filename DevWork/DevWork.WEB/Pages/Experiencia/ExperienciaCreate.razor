@page "/ExperienciaProfesional/create"
@using DevWork.Shared.Models
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<h3>Crear experiencia profesional</h3>

<ExperienciaForm @ref="experienciaForm" Experiencia="experiencia" OnSubmit="Create" ReturnAction="Return" />

@code {
    private ExperienciaProfesionalModel experiencia = new();
    private ExperienciaForm experienciaForm = null!;

    private async Task Create()
    {
        var responseHttp = await repository.PostAsync("api/experiencias", experiencia);
        if (responseHttp.Error)
        {
            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        experienciaForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("ExperienciaProfesional");
    }

    private void Return() => navigationManager.NavigateTo("ExperienciaProfesional");
}


