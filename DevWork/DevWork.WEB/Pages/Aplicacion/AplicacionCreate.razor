@page "/aplicaciones/create"
@using DevWork.Shared.Models
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<h3>Crear aplicación</h3>

<AplicacionForm @ref="aplicacionForm" Aplicacion="aplicacion" OnSubmit="Create" ReturnAction="Return" />

@code {
    private Aplicacion aplicacion = new();
    private AplicacionForm aplicacionForm = null!;

    private async Task Create()
    {
        var responseHttp = await repository.PostAsync("api/aplicaciones", aplicacion);
        if (responseHttp.Error)
        {
            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        aplicacionForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("aplicaciones");
    }

    private void Return() => navigationManager.NavigateTo("aplicaciones");
}

