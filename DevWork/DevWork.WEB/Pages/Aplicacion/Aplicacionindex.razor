@page "/aplicaciones"
@inject NavigationManager navigationManager
@inject SweetAlertService swal
@inject IRepository repository
<h3>Aplicacion</h3>

<div class="mb-3">

 

 

    <a class="btn btn-primary " href="/aplicaciones/Create">New Aplicacion</a>

 

</div>

 

<GenericList MyList="aplicaciones">


    <Body>

        <table class="table table-striped">

            <thead>

                <tr>

                    <th>Id</th>

                    <th>PublicacionId</th>
                    <th>PerfilProfesionalId</th>
                    <th>PropuestaMensaje</th>
                    <th>Estado</th>
                    <th>FechaPostulacion</th>
                   

                   

                </tr>

            </thead>

            <tbody>

                @foreach (var aplicacion in aplicaciones!)

                {

                    <tr>

                         

                        <td>

                            @aplicacion.Id

                        </td>

                        <td>

                            @aplicacion.PublicacionId

                        </td>
                        <td>

                            @aplicacion.PropuestaMensaje

                        </td>
                        <td>

                            @aplicacion.Estado

                        </td>
                        <td>

                            @aplicacion.FechaPostulacion

                        </td>

                        
                        <td>

                            <a href="/aplicaciones/edit/@aplicacion.Id" class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger" @onclick=@(() => DeleteAsync(aplicacion))>Borrar</button>

                        </td>

 

                    </tr>

                }

            </tbody>

        </table>

 

    </Body>

  

</GenericList>

 

 

 

 

 

@code {
    public List<Aplicacion> aplicaciones { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var responseHppt = await repository.GetAsync<List<Aplicacion>>("/api/Aplicaciones");
        aplicaciones = responseHppt.Response!;
    }

    private async Task DeleteAsync(Aplicacion Aplicacion)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Esta seguro que quieres borrar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        var confirm = string.IsNullOrEmpty(result.Value);

        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.DeleteAsync($"api/Aplicaciones/{Aplicacion.Id}");

        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/aplicaciones");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await Load();
        }
    }

  
 

    }



 








