@page "/preguntas"
@inject NavigationManager navigationManager
@inject SweetAlertService swal

@inject IRepository repository



<h3>Pregunta</h3>

<div class="mb-3">

 

 

    <a class="btn btn-primary " href="/Preguntas/Create">New Pregunta</a>

 

</div>

 

<GenericList MyList="Preguntas">


    <Body>

        <table class="table table-striped">

            <thead>

                <tr>

                    <th>Id</th>

                    <th>PublicacionId</th>
                    <th>TextoPregunta</th>
                   

                   

                </tr>

            </thead>

            <tbody>

                @foreach (var pregunta in Preguntas!)

                {

                    <tr>

                         

                        <td>

                            @pregunta.Id

                        </td>

                        <td>

                            @pregunta.PublicacionId

                        </td>
                        <td>

                            @pregunta.TextoPregunta

                        </td> 

                        
                        <td>

                            <a href="/Preguntas/edit/@pregunta.Id" class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger" @onclick=@(() => DeleteAsync(pregunta))>Borrar</button>

                        </td>

 

                    </tr>

                }

            </tbody>

        </table>

 

    </Body>

  

</GenericList>

 

 

 

 

 

@code {
    // Asegúrate de que este nombre coincida en mayúsculas/minúsculas con tu HTML
    public List<Pregunta>? Preguntas { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var responseHttp = await repository.GetAsync<List<Pregunta>>("api/preguntas");
        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await swal.FireAsync("Error", $"No se pudieron cargar las preguntas: {mensajeError}", SweetAlertIcon.Error);
            Preguntas = new List<Pregunta>();
            return;
        }

        Preguntas = responseHttp.Response!;
    }

    private async Task DeleteAsync(Pregunta item)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Está seguro que quieres borrar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.DeleteAsync($"api/preguntas/{item.Id}");
        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("preguntas");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await Load();
        }
    }
}
