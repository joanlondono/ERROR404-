@page "/preguntas/create"
@using DevWork.Shared.Models
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<h3>Crear pregunta</h3>

<PreguntaForm @ref="preguntaForm" Pregunta="pregunta" OnSubmit="Create" ReturnAction="Return" />

@code {
    private Pregunta pregunta = new();
    private PreguntaForm preguntaForm = null!;

    private async Task Create()
    {
        var responseHttp = await repository.PostAsync("api/preguntas", pregunta);
        if (responseHttp.Error)
        {
            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        preguntaForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("preguntas");
    }

    private void Return() => navigationManager.NavigateTo("preguntas");
}
