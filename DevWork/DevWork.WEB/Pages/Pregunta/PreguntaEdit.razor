@page "/preguntas/edit/{Id:int}"

@inject NavigationManager navigationManager
@inject IRepository repository
@inject SweetAlertService swal

<h3>Editar pregunta</h3>

@if (pregunta is null)
{
    <p>Cargando...</p>
}
else
{
    <PreguntaForm @ref="preguntaForm"
                  Pregunta="pregunta"
                  OnSubmit="Edit"
                  ReturnAction="Return" />
}

@code {
    private PreguntaModel? pregunta;
    private PreguntaForm preguntaForm = null!;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var response = await repository.GetAsync<PreguntaModel>(
            $"/api/pregunta/{Id}");

        if (response.Error)
        {
            if (response.HttpResponseMessage.StatusCode ==
                System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/preguntas");
                return;
            }

            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        pregunta = response.Response;
    }

    private async Task Edit()
    {
        var response = await repository.PutAsync("/api/pregunta", pregunta);

        if (response.Error)
        {
            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        preguntaForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("/preguntas");
    }

    private void Return()
    {
        navigationManager.NavigateTo("/preguntas");
    }
}

 