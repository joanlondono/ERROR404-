@page "/certificaciones/edit/{Id:int}"
@attribute [Authorize(Roles = "Admin,Administrador")]
@using DevWork.Shared.Models
@inject NavigationManager navigationManager
@inject IRepository repository
@inject SweetAlertService swal

<h3>Editar certificación</h3>

@if (certificacion is null)
{
    <p>Cargando...</p>
}
else
{
    <CertificacionForm @ref="certificacionForm"
                       Certificacion="certificacion"
                       OnSubmit="Edit"
                       ReturnAction="Return" />
}

@code {
    private CertificacionModel? certificacion;
    private CertificacionForm certificacionForm = null!;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var response = await repository.GetAsync<CertificacionModel>($"api/certificaciones/{Id}");

        if (response.Error)
        {
            if (response.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("certificaciones");
                return;
            }

            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        certificacion = response.Response;
    }

    private async Task Edit()
    {
        var response = await repository.PutAsync("api/certificaciones", certificacion);

        if (response.Error)
        {
            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        certificacionForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("certificaciones");
    }

    private void Return()
    {
        navigationManager.NavigateTo("certificaciones");
    }
}
