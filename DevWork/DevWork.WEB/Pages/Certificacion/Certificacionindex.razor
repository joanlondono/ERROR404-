@page "/certificaciones"
@inject NavigationManager navigationManager
@inject SweetAlertService swal
@inject IRepository repository
<h3>Certificacion</h3>
<div class="mb-3">

 

 

    <a class="btn btn-primary " href="/certificaciones/Create">New Certificacion</a>

 

</div>

 

<GenericList MyList="certificaciones">


    <Body>

        <table class="table table-striped">

            <thead>

                <tr>

                    <th>Id</th>

                    <th>PerfilProfesionalId</th>
                    <th>Nombre</th>
                    <th>EnteEmisor</th>
                    <th>FechaObtencion</th>
                    <th>UrlCreedencial</th>

                   

                </tr>

            </thead>

            <tbody>

                @foreach (var certificacion in certificaciones!)

                {

                    <tr>

                         

                        <td>

                            @certificacion.Id

                        </td>

                        <td>

                            @certificacion.PerfilProfesionalId

                        </td>
                        <td>

                            @certificacion.Nombre

                        </td>
                        <td>

                            @certificacion.EnteEmisor

                        </td>
                        <td>

                            @certificacion.FechaObtencion

                        </td>
                        <td>

                            @certificacion.UrlCredencial

                        </td>

                        
                        <td>

                            <a href="/certificaciones/edit/@certificacion.Id" class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger" @onclick=@(() => DeleteAsync(certificacion))>Borrar</button>

                        </td>

 

                    </tr>

                }

            </tbody>

        </table>

 

    </Body>

  

</GenericList>

 

 

 

 

 

@code {
    // Verifica si en tu HTML arriba dice MyList="Certificaciones" o MyList="certificaciones"
    public List<Certificacion>? certificaciones { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var responseHttp = await repository.GetAsync<List<Certificacion>>("api/certificaciones");
        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await swal.FireAsync("Error", $"No se pudieron cargar las certificaciones: {mensajeError}", SweetAlertIcon.Error);
            certificaciones = new List<Certificacion>();
            return;
        }

        certificaciones = responseHttp.Response!;
    }

    private async Task DeleteAsync(Certificacion certificacion)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Está seguro que quieres borrar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.DeleteAsync($"api/certificaciones/{certificacion.Id}");
        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("certificaciones");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await Load();
        }
    }
}
