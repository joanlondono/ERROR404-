@page "/certificaciones/create"
@using DevWork.Shared.Models
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<h3>Crear certificación</h3>

<CertificacionForm @ref="certificacionForm" Certificacion="certificacion" OnSubmit="Create" ReturnAction="Return" />

@code {
    private Certificacion certificacion = new();
    private CertificacionForm certificacionForm = null!;

    private async Task Create()
    {
        var responseHttp = await repository.PostAsync("api/certificaciones", certificacion);
        if (responseHttp.Error)
        {
            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        certificacionForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("certificaciones");
    }

    private void Return() => navigationManager.NavigateTo("certificaciones");
}
