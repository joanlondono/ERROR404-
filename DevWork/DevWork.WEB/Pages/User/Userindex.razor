@page "/Users" 

@inject NavigationManager navigationManager
@inject SweetAlertService swal
 

 

@inject IRepository repository

<h3>User</h3>

<div class="mb-3">

 

 

    <a class="btn btn-primary " href="/Users/Create">New User</a>

 

</div>

 

<GenericList MyList="Users">

 

    <Body>

        <table class="table table-striped">

            <thead>

                <tr>

                    <th>Id</th>

                    <th>Email</th>

                    <th>Password</th>

                    <th>RoleId</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var user in Users!)

                {

                    <tr>

                         

                        <td>

                            @user.Id

                        </td>

                        <td>

                            @user.Email 

                        </td>
                        <td>
                            @user.Password
                        </td>

 

                        

                        <td>

                            @user.RoleId

                        </td>

 

 

                      

 

 

 

                        <td>

                            <a href="/Users/edit/@user.Id" class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger" @onclick=@(() => DeleteAsync(user))>Borrar</button>

                        </td>

 

                    </tr>

                }

            </tbody>

        </table>

 

    </Body>

  

</GenericList>

 

 

 

 

 

@code {

    public List<UserModel> Users { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var responseHppt = await repository.GetAsync<List<UserModel>>("/api/Users");
        Users = responseHppt.Response!;
    }

    private async Task DeleteAsync(UserModel User)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Esta seguro que quieres borrar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        var confirm = string.IsNullOrEmpty(result.Value);

        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.DeleteAsync($"api/Users/{User.Id}");

        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/users");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await Load();
        }
    }

}

 
