@page "/roles"

@inject NavigationManager navigationManager
@inject SweetAlertService swal
 

@inject IRepository repository

<h3>Role</h3>

<div class="mb-3">

 

 

<a class="btn btn-primary " href="/Roles/Create">New Role</a>

 

</div>

 

<GenericList MyList="Roles">

 

    <Body>

        <table class="table table-striped">

            <thead>

                <tr>

                    <th>Id</th>

                    <th>Nombre</th>

                   

                </tr>

            </thead>

            <tbody>

                @foreach (var role in Roles !)

                {

                    <tr>

                         

                        <td>

                            @role.Id

                        </td>

                        <td>

                            @role.Name

                        </td>

 

                        


 

                      

 

 

 

                        <td>

                            <a href="/Roles/edit/@role.Id" class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger" @onclick=@(() => DeleteAsync(role))>Borrar</button>

                        </td>

 

                    </tr>

                }

            </tbody>

        </table>

 

    </Body>

  

</GenericList>

 

 

 

 

 

@code {
    public List<RoleModel> Roles { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var responseHppt = await repository.GetAsync<List<RoleModel>>("/api/Roles");
        Roles = responseHppt.Response!;
    }

    private async Task DeleteAsync(RoleModel Role)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Esta seguro que quieres borrar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        var confirm = string.IsNullOrEmpty(result.Value);

        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.DeleteAsync($"api/Roles/{Role.Id}");

        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/roles");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await Load();
        }
    }

}

 




