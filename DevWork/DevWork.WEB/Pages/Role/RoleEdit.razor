@page "/roles/edit/{Id:int}"
@using DevWork.Shared.Models
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<h3>Editar Rol</h3>

@if (role is null)
{
    <p>Cargando...</p>
}
else
{
    <RoleForm @ref="roleForm" Role="role" OnSubmit="Edit" ReturnAction="Return" />
}

@code {
    private Role? role;
    private RoleForm roleForm = null!;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var responseHttp = await repository.GetAsync<Role>($"api/roles/{Id}");
        if (responseHttp.Error)
        {
            if (responseHttp.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("roles");
            }
            else
            {
                var messageError = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", messageError, SweetAlertIcon.Error);
            }
        }
        else
        {
            role = responseHttp.Response;
        }
    }

    private async Task Edit()
    {
        var responseHttp = await repository.PutAsync("api/roles", role);
        if (responseHttp.Error)
        {
            var messageError = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", messageError, SweetAlertIcon.Error);
            return;
        }

        roleForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("roles");
    }

    private void Return() => navigationManager.NavigateTo("roles");
}
