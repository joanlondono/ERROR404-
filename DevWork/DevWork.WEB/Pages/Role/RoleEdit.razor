@page "/roles/edit/{Id:int}"

@inject NavigationManager navigationManager
@inject IRepository repository
@inject SweetAlertService swal

<h3>Editar rol</h3>

@if (role is null)
{
    <p>Cargando...</p>
}
else
{
    <RoleForm @ref="roleForm"
              Role="role"
              OnSubmit="Edit"
              ReturnAction="Return" />
}

@code {
    private RoleModel? role;
    private RoleForm roleForm = null!;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var response = await repository.GetAsync<RoleModel>($"/api/role/{Id}");

        if (response.Error)
        {
            if (response.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/roles");
                return;
            }

            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        role = response.Response;
    }

    private async Task Edit()
    {
        var response = await repository.PutAsync("/api/role", role);

        if (response.Error)
        {
            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        roleForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("/roles");
    }

    private void Return()
    {
        navigationManager.NavigateTo("/roles");
    }
}

 