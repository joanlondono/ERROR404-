@page "/roles/create"
@using DevWork.Shared.Models
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<h3>Crear rol</h3>

<RoleForm @ref="roleForm" Role="role" OnSubmit="Create" ReturnAction="Return" />

@code {
    private Role role = new();
    private RoleForm roleForm = null!;

    private async Task Create()
    {
        var responseHttp = await repository.PostAsync("api/roles", role);
        if (responseHttp.Error)
        {
            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        roleForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("roles");
    }

    private void Return() => navigationManager.NavigateTo("roles");
}
