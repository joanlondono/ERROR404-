@page "/publicaciones/create"

@using DevWork.Shared.Models

@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<h3>Crear publicación</h3>

<PublicacionForm @ref="publicacionForm" Publicacion="publicacion" OnSubmit="Create" ReturnAction="Return" />

@code {
    private PublicacionModel publicacion = new();
    private PublicacionForm publicacionForm = null!;

    private async Task Create()
    {
        // Se corrige la ruta relativa en plural "api/publicaciones"
        var responseHttp = await repository.PostAsync("api/publicaciones", publicacion);
        
        if (responseHttp.Error)
        {
            // Se corrige el nombre del método a GetErrorMessageAsync
            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        // Se corrige el nombre de la variable a publicacionForm
        publicacionForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("publicaciones");
    }

    private void Return()
    {
        navigationManager.NavigateTo("publicaciones");
    }
}



