@page "/publicaciones/edit/{Id:int}"
@attribute [Authorize]
@using DevWork.Shared.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject NavigationManager navigationManager
@inject IRepository repository
@inject SweetAlertService swal
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Editar Publicación - DevWork</PageTitle>

<div class="mb-3">
    <a href="/publicaciones" class="btn btn-sm btn-outline-light">
        ← Volver a Publicaciones
    </a>
</div>

<div class="mx-auto" style="max-width: 820px;">
    <div class="p-4 p-md-5 rounded-4" style="background-color: #111827; border: 1px solid rgba(255,255,255,0.08);">
        <div class="mb-4 pb-3 border-bottom" style="border-color: rgba(255,255,255,0.08) !important;">
            <h3 class="fw-bold text-white mb-1">Editar Publicación</h3>
            <small style="color: #94A3B8;">Actualiza los detalles, área o presupuesto de tu oferta</small>
        </div>

        @if (publicacion is null)
        {
            <div class="d-flex justify-content-center my-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            <PublicacionForm @ref="publicacionForm"
                             Publicacion="publicacion"
                             OnSubmit="Edit"
                             ReturnAction="Return" />
        }
    </div>
</div>

@code {
    private PublicacionModel? publicacion;
    private PublicacionForm publicacionForm = null!;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        bool esAdmin = user.IsInRole("Admin") || user.IsInRole("Administrador");
        var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                   ?? user.FindFirst("UserId")?.Value
                   ?? user.FindFirst("id")?.Value
                   ?? user.FindFirst("sub")?.Value;
        int.TryParse(idClaim, out int usuarioActualId);

        var response = await repository.GetAsync<PublicacionModel>($"api/publicaciones/{Id}");

        if (response.Error)
        {
            if (response.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/publicaciones");
                return;
            }

            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        var pubCargada = response.Response!;

        // Bloquear acceso si intentó entrar por URL a una publicación ajena
        if (!esAdmin && pubCargada.UserId != usuarioActualId)
        {
            await swal.FireAsync("Acceso denegado", "No tienes permiso para editar esta publicación.", SweetAlertIcon.Warning);
            navigationManager.NavigateTo("/publicaciones");
            return;
        }

        publicacion = pubCargada;
    }

    private async Task Edit()
    {
        var response = await repository.PutAsync("api/publicaciones", publicacion);

        if (response.Error)
        {
            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        publicacionForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("/publicaciones");
    }

    private void Return()
    {
        navigationManager.NavigateTo("/publicaciones");
    }
}