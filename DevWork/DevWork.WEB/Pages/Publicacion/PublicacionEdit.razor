@page "/@page/publicaciones/edit/{Id:int}"

@inject NavigationManager navigationManager
@inject IRepository repository
@inject SweetAlertService swal

<h3>Editar publicación</h3>

@if (publicacion is null)
{
    <p>Cargando...</p>
}
else
{
    <PublicacionForm @ref="publicacionForm"
                     Publicacion="publicacion"
                     OnSubmit="Edit"
                     ReturnAction="Return" />
}

@code {
    private PublicacionModel? publicacion;
    private PublicacionForm publicacionForm = null!;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var response = await repository.GetAsync<PublicacionModel>(
            $"/api/publicacion/{Id}");

        if (response.Error)
        {
            if (response.HttpResponseMessage.StatusCode ==
                System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/publicaciones");
                return;
            }

            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        publicacion = response.Response;
    }

    private async Task Edit()
    {
        var response = await repository.PutAsync("/api/publicacion", publicacion);

        if (response.Error)
        {
            var message = await response.GetErrorMessageAsync();
            await swal.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        publicacionForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("/publicaciones");
    }

    private void Return()
    {
        navigationManager.NavigateTo("/publicaciones");
    }
}