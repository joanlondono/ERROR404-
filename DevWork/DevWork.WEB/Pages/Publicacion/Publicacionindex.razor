@page "/publicaciones"
@inject NavigationManager navigationManager
@inject SweetAlertService swal

@inject IRepository repository


<h3>Publicacion</h3>
<div class="mb-3">

 

 

    <a class="btn btn-primary " href="/Publicaciones/Create">New Publicacion</a>

 

</div>

 

<GenericList MyList="Publicaciones">


    <Body>

        <table class="table table-striped">

            <thead>

                <tr>

                    <th>Id</th>

                    <th>Titulo</th>
                    <th>Descripcion</th>
                    <th>AreaSistemas</th>
                    <th>TipoOferta</th>
                    <th>UserId</th>

                   

                </tr>

            </thead>

            <tbody>

                @foreach (var publicacion in Publicaciones!)

                {

                    <tr>

                         

                        <td>

                            @publicacion.Id

                        </td>

                        <td>

                            @publicacion.Titulo

                        </td>
                        <td>

                            @publicacion.Descripcion

                        </td>
                        <td>

                            @publicacion.AreaSistemas

                        </td>
                        <td>

                            @publicacion.TipoOferta

                        </td>
                        <td>

                            @publicacion.UserId

                        </td>

 

                        
                        <td>

                            <a href="/Publicaciones/edit/@publicacion.Id" class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger" @onclick=@(() => DeleteAsync(publicacion))>Borrar</button>

                        </td>

 

                    </tr>

                }

            </tbody>

        </table>

 

    </Body>

  

</GenericList>

 

 

 

 

 

@code {

    public List<Publicacion> Publicaciones { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var responseHppt = await repository.GetAsync<List<Publicacion>>("/api/publicaciones");
        Publicaciones = responseHppt.Response!;
    }

    private async Task DeleteAsync(Publicacion Publicacion)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Esta seguro que quieres borrar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        var confirm = string.IsNullOrEmpty(result.Value);

        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.DeleteAsync($"api/Publicaciones/{Publicacion.Id}");

        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/publicaciones");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await Load();
        }
    }

}

 






